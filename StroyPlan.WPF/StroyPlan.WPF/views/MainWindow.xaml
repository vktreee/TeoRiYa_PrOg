<Window x:Class="StroyPlan.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СтройПлан" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Заголовок -->
            <RowDefinition Height="56"/>
            <!-- Панель инструментов -->
            <RowDefinition Height="*"/>
            <!-- Основное содержимое -->
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ОКНА ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0">
                    <Border Background="{StaticResource AccentColor}"
                            Width="24" Height="24" CornerRadius="4">
                        <TextBlock Text="🏗" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="СтройПлан" FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"/>
                    <Button Content="▢" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ ПАНЕЛЬ ИНСТРУМЕНТОВ ============ -->
        <Border Grid.Row="1" Background="{StaticResource BgColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Файл ▾" Padding="10,6"
                        Background="Transparent" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button Padding="10,6" Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" FontSize="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0"/>
                            <TextBlock Text="Новый"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" FontSize="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0"/>
                            <TextBlock Text="Открыть"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Background="Transparent"
                            BorderThickness="0" FontSize="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="3" Padding="12,6"
                        Background="{StaticResource BgColor}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        FontSize="12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☀" Margin="0,0,6,0"/>
                        <TextBlock Text="Светлая тема"/>
                        <TextBlock Text="▾" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ ОСНОВНОЕ СОДЕРЖИМОЕ ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <!-- Левое меню -->
                <ColumnDefinition Width="*"/>
                <!-- Kanban -->
                <ColumnDefinition Width="340"/>
                <!-- Панель задачи -->
            </Grid.ColumnDefinitions>

            <!-- ЛЕВОЕ МЕНЮ -->
            <Border Grid.Column="0" Background="{StaticResource BgColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16">
                    <TextBlock Text="Объекты" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Button Content="+ Новый объект"
                            Background="{StaticResource AccentColor}"
                            Foreground="White" BorderThickness="0"
                            Padding="12,10" FontSize="13"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"/>

                    <!-- Список объектов будет добавлен позже -->
                </StackPanel>
            </Border>

            <!-- ЦЕНТР: Kanban -->
            <Grid Grid.Column="1" Background="{StaticResource PanelColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка Kanban -->
                <Grid Grid.Row="0" Margin="16,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Канбан-доска"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="2" Width="140" Margin="0,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="Все задачи"/>
                    </ComboBox>

                    <Border Grid.Column="3" Width="200" Margin="0,0,8,0"
                            Background="White" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Margin="10,6">
                            <TextBlock Text="🔍" Margin="0,0,6,0"/>
                            <TextBlock Text="Поиск задач..." Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="4" Content="⚙ Настройки вида"
                            Padding="10,6" Background="White"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                </Grid>

                <!-- Колонки Kanban (пустые) -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Padding="16,0">
                    <StackPanel Orientation="Horizontal">

                        <!-- Новая -->
                        <Border Width="200" Background="{StaticResource ColumnColor}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Новая" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <Button Grid.Row="1" Content="+ Добавить задачу"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}"
                                        HorizontalContentAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- В работе -->
                        <Border Width="200" Background="{StaticResource ColumnColor}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="В работе" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <Button Grid.Row="1" Content="+ Добавить задачу"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}"
                                        HorizontalContentAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- На проверке -->
                        <Border Width="200" Background="{StaticResource ColumnColor}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="На проверке" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <Button Grid.Row="1" Content="+ Добавить задачу"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}"
                                        HorizontalContentAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Выполнена -->
                        <Border Width="200" Background="{StaticResource ColumnColor}"
                                CornerRadius="8" Margin="0,0,12,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Выполнена" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <Button Grid.Row="1" Content="+ Добавить задачу"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}"
                                        HorizontalContentAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Отложена -->
                        <Border Width="200" Background="{StaticResource ColumnColor}"
                                CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Отложена" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="0" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <Button Grid.Row="1" Content="+ Добавить задачу"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}"
                                        HorizontalContentAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ПРАВО: Панель задачи (пустая) -->
            <Border Grid.Column="2" Background="{StaticResource BgColor}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <StackPanel Margin="107,20,20,20">
                    <TextBlock Text="Задача не выбрана"
                               FontSize="14"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>